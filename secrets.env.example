# PandaHat production secrets — TEMPLATE. Copy to `secrets.env` (gitignored) and fill in.
# Never commit secrets.env. Real values live in Google Secret Manager / Firebase / GitHub, not in the repo.
# Where each value goes is noted on the line above it (see docs/DEPLOY.md).

# ── Database (Neon) ─────────────────────────────────────────────────────────
# Neon → Connection details → Pooled connection. → Secret Manager: pandahat-database-url
DATABASE_URL=

# ── Sign in with GitHub (Firebase Auth) ────────────────────────────────────
# Firebase → Project settings. → Cloud Run env var FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=
# People who become admins on first sign-in, comma-separated. → Secret Manager: pandahat-bootstrap-admins
BOOTSTRAP_ADMIN_EMAILS=
# GitHub org → Settings → Developer settings → OAuth Apps. Paste BOTH into Firebase → Auth → GitHub provider.
# (Kept here only so you have them in one place; the app never reads them.)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Firebase web config (public, not secret) → frontend/apphosting.yaml
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Phase D: GitHub → PandaHat webhook ─────────────────────────────────────
# Generate with: openssl rand -hex 32. Same value in the org webhook settings and → Secret Manager: pandahat-github-webhook-secret
GITHUB_WEBHOOK_SECRET=

# ── Phase E: Email (Resend) ────────────────────────────────────────────────
# Resend → API Keys → "Sending access" only, restricted to your domain. → Secret Manager: pandahat-resend-api-key
RESEND_API_KEY=
# An address on your verified domain, e.g. "PandaHat <notifications@yourdomain.org>"
EMAIL_FROM_ADDRESS=
# Token Cloud Scheduler sends to /internal/jobs/deadline-reminders. openssl rand -hex 32 → Secret Manager: pandahat-jobs-token
INTERNAL_JOBS_TOKEN=
