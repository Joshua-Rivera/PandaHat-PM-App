# Server-side only (not exposed to the browser). Next.js proxies /api/* here.
BACKEND_URL=http://localhost:8000

# "dev"      → the "Viewing as" switcher (sends X-Dev-User-Id). Laptop only.
# "firebase" → real Sign in with GitHub. Pairs with the backend's AUTH_MODE.
NEXT_PUBLIC_AUTH_MODE=dev

# DEV ONLY (optional): who you are on first load before choosing in "Viewing as".
NEXT_PUBLIC_DEV_USER_ID=

# Firebase web config (Project settings → Your apps). Public values, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
