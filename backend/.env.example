# Local development (docker compose Postgres + dev identity switcher).
DATABASE_URL=postgresql+psycopg://pandahat:pandahat@localhost:5432/pandahat
ENVIRONMENT=development
AUTH_MODE=dev
APP_BASE_URL=http://localhost:3000

# To try real GitHub sign-in locally, set these instead of AUTH_MODE=dev:
# AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=your-firebase-project-id
# BOOTSTRAP_ADMIN_EMAILS=you@example.com
